<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib uri="http://java.sun.com/jsp/jstl/core" prefix="c" %>
<!DOCTYPE html>
<html>
<head>
    <title>Araç Kirala - Sell&Book</title>
    <style>
        .rent-a-car-container {
            padding: 20px;
        }

        h1 {
            margin-bottom: 20px;
        }

        .vehicle-list {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        .vehicle-list th, .vehicle-list td {
            border: 1px solid #dee2e6;
            padding: 8px;
            text-align: left;
        }

        .vehicle-list th {
            background-color: #f8f9fa;
            font-weight: bold;
        }

        .rent-button-container {
            text-align: center;
        }

        .rent-button {
            background-color: #007bff;
            color: white;
            border: none;
            padding: 10px 15px;
            border-radius: 4px;
            cursor: pointer;
            text-decoration: none;
            font-size: 16px;
            transition: background-color 0.3s ease;
        }

        .rent-button:hover {
            background-color: #0056b3;
        }

        .filter-section {
            margin-bottom: 20px;
            padding: 15px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            background-color: #f8f9fa;
        }

        .filter-section label {
            display: inline-block;
            margin-right: 10px;
            font-weight: bold;
        }

        .filter-section input[type="text"],
        .filter-section select {
            padding: 8px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            margin-right: 15px;
            margin-bottom: 5px;
        }

        .filter-button {
            background-color: #28a745;
            color: white;
            border: none;
            padding: 8px 12px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 14px;
            transition: background-color 0.3s ease;
        }

        .filter-button:hover {
            background-color: #218838;
        }

        .rental-info {
            margin-top: 20px;
            padding: 15px;
            border: 1px solid #ced4da;
            border-radius: 4px;
            background-color: #e9ecef;
        }

        .rental-info p {
            margin-bottom: 5px;
        }

        .success-message {
            color: green;
            margin-bottom: 10px;
        }

        .error-message {
            color: red;
            margin-bottom: 10px;
        }
    </style>
</head>
<body>
    <div class="rent-a-car-container">
        <h1>Araç Kirala</h1>

        <% if (request.getAttribute("rentalSuccess") != null && (Boolean) request.getAttribute("rentalSuccess")) { %>
            <div class="success-message">İşlem başarılı! Kiralanan araçları "Kiralanan Araçlar" sekmesinde görüntüleyebilirsiniz.</div>
        <% } %>
        <% if (request.getAttribute("rentalError") != null) { %>
            <div class="error-message"><%= request.getAttribute("rentalError") %></div>
        <% } %>

        <div class="filter-section">
            <h3>Filtreler</h3>
            <label for="brand">Marka:</label>
            <input type="text" id="brand" name="brand">
            <label for="model">Model:</label>
            <input type="text" id="model" name="model">
            <label for="year">Yıl:</label>
            <input type="text" id="year" name="year">
            <button class="filter-button">Filtrele</button>
        </div>

        <table class="vehicle-list">
            <thead>
                <tr>
                    <th>Marka</th>
                    <th>Model</th>
                    <th>Yıl</th>
                    <th>Fiyat</th>
                    <th>İşlem</th>
                </tr>
            </thead>
            <tbody>
                <c:forEach var="vehicle" items="${availableVehicles}">
                    <tr>
                        <td><c:out value="${vehicle.brand}"/></td>
                        <td><c:out value="${vehicle.model}"/></td>
                        <td><c:out value="${vehicle.year}"/></td>
                        <td class="rent-button-container">
                            <form action="rent-process" method="post">
                                <input type="hidden" name="vehicleId" value="${vehicle.id}">
                                <button type="submit" class="rent-button">Kirala</button>
                            </form>
                        </td>
                    </tr>
                </c:forEach>
                <c:if test="${empty availableVehicles}">
                    <tr><td colspan="5">Kiralayabileceğiniz araç bulunmamaktadır.</td></tr>
                </c:if>
            </tbody>
        </table>

        <div class="rental-info">
            <h3>Kiralama Bilgileri</h3>
            <p>Listelenen araçlar şu anda kiralanabilir durumdadır.</p>
            <p>"Kirala" butonuna tıkladığınızda kiralama işlemi başlatılacaktır.</p>
            </div>
    </div>
</body>
</html>