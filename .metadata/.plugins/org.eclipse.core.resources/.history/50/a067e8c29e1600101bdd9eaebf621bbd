package com.sellandrent.web;

import com.sellandrent.model_tier.Customer;
import com.sellandrent.model_tier.Rent;
import com.sellandrent.service_tier.RentService;

import jakarta.servlet.ServletException;
import jakarta.servlet.annotation.WebServlet;
import jakarta.servlet.http.HttpServlet;
import jakarta.servlet.http.HttpServletRequest;
import jakarta.servlet.http.HttpServletResponse;
import jakarta.servlet.http.HttpSession;
import java.io.IOException;
import java.sql.Date;
import java.time.LocalDate;

@WebServlet("/rent-process")
public class RentProcessServlet extends HttpServlet {
    private static final long serialVersionUID = 1L;
    private RentService rentService;

    @Override
    public void init() throws ServletException {
        rentService = new RentService();
    }

    protected void doPost(HttpServletRequest request, HttpServletResponse response) throws ServletException, IOException {
        String vehicleIdStr = request.getParameter("vehicleId");
        HttpSession session = request.getSession(false);
        Customer loggedInUser = (Customer) session.getAttribute("loggedInUser");

        if (vehicleIdStr != null && loggedInUser != null) {
            try {
                int vehicleId = Integer.parseInt(vehicleIdStr);

                Rent newRent = new Rent();
                newRent.setVehicleId(vehicleId);
                newRent.setCustomerId(loggedInUser.getId());
                newRent.setStartDate(Date.valueOf(LocalDate.now()));
                newRent.setEndDate(Date.valueOf(LocalDate.now().plusDays(7)));

                rentService.addRent(newRent);

                // Başarılı durumda rent-process.jsp'ye yönlendir.
                response.sendRedirect("rent-process.jsp?rentalSuccess=true");
                return;

            } catch (NumberFormatException e) {
                e.printStackTrace();
                // Hata durumunda rent-process.jsp'ye yönlendir.
                response.sendRedirect("rent-process.jsp?rentalError=invalidVehicleId");
                return;
            }
        } else {
            // Hata durumunda rent-process.jsp'ye yönlendir.
            response.sendRedirect("rent-process.jsp?rentalError=missingInfo");
            return;
        }
    }

    @Override
    public void destroy() {
        rentService.closeConnection();
    }
}