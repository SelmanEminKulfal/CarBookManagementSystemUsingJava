<%@ page language="java" contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.sellandrent.model_tier.Customer" %>

<!DOCTYPE html>
<html>
<head>
<link rel="stylesheet">
    <title>Kullanıcı Paneli - Sell&Book</title>
    <style>
.navbar {
    background-color: #333;
    color: white;
    padding: 15px 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.navbar-left {
    font-size: 20px;
    font-weight: bold;
}

.navbar-right a, .navbar-right button {
    color: white;
    text-decoration: none;
    margin-left: 15px;
    padding: 8px 12px;
    border: none;
    border-radius: 4px;
    background-color: transparent;
    cursor: pointer;
    font-size: 16px;
}

.navbar-right button {
    background-color: #d9534f; /* Kırmızımsı bir renk */
}

.navbar-right button:hover {
    background-color: #c9302c;
}

.container {
    display: flex;
    width: 100%;
    max-width: 1200px; /* İsteğe bağlı maksimum genişlik */
    margin: 0 auto; /* Sayfayı ortala */
}

.aside {
    width: 250px;
    background-color: #f8f9fa; /* Açık gri bir arka plan */
    padding: 20px;
    border-right: 1px solid #dee2e6; /* Sağ çizgi */
    display: flex;
    flex-direction: column;
    align-items: flex-start; /* İçeriği sola yasla */
}

.profile-info {
    display: flex;
    align-items: center;
    margin-bottom: 20px;
}
.profile-icon {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: #007bff; /* Mavi bir ikon rengi */
    color: white;
    font-size: 20px;
    text-align: center;
    line-height: 40px;
    margin-right: 10px;
}

.profile-name {
    font-weight: bold;
}

.aside-links {
    list-style: none;
    padding: 0;
    margin: 0;
    width: 100%;
}

.aside-links li {
    margin-bottom: 10px;
}

.aside-links li a {
    display: block;
    color: #333;
    text-decoration: none;
    padding: 8px 12px;
    border-radius: 4px;
	transition: background-color 0.3s ease;
}
.aside-links li a:hover {
	background-color: #e9ecef;
}

.content {
    flex-grow: 1;
	padding: 20px;
}
    </style>
</head>
<body>
    <div class="container">
        <div class="header">
            <h1>Sell&Rent</h1>
            <div class="user-info">
    <% Customer loggedInUser = (Customer) session.getAttribute("loggedInUser"); %>
    <% if (loggedInUser != null) { %>
        <span class="username"><%= loggedInUser.getName() %> <%= loggedInUser.getSurname() %></span>
        <% } else { %>
        <span class="guest">Misafir Kullanıcı</span>
    <% } %>
    <form action="logout" method="post">
        <button type="submit" class="navbar-button" style="background-color: #d9534f;">Logout</button>
    </form>
</div>
        </div>
        <div class="content">
            <h2>Kullanıcı Paneline Hoş Geldiniz</h2>
            <p>Burada diğer sayfalara erişebilir veya kişisel bilgilerinizi yönetebilirsiniz.</p>
            <ul class="aside-links">
                <li><a href="rent-a-car">Araç Kirala</a></li>
                <li><a href="rented-vehicles">Kiralanan Araçlar</a></li>
                <li><a href="change-password">Şifremi Yenile</a></li>
                <li><a href="delete-account">Hesabımı Sil</a></li>
            </ul>
        </div>
    </div>
</body>
</html>