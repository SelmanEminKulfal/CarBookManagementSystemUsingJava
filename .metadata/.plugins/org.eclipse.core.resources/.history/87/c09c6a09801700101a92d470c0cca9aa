package com.sellandrent.service_tier;

import com.sellandrent.model_tier.Customer;
import com.sellandrent.repository_tier.Customer_Repository;
import com.sellandrent.DatabaseConnectionTest;

import java.sql.Connection;
import java.sql.SQLException;
import java.util.List;

public class CustomerService {
    private Customer_Repository customer_repository;
    private Connection connection;

    public CustomerService() {
        try {
            connection = DatabaseConnectionTest.createConnection();
            customer_repository = new Customer_Repository(connection);
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    public Customer getCustomerById(int id) {
        try {
            return customer_repository.getCustomerById(id);
        } catch (SQLException e) {
            e.printStackTrace();
            return null;
        }
    }

    public Customer getCustomerByEmail(String email) {
        try {
            return customer_repository.getCustomerByEmail(email);
        } catch (SQLException e) {
            e.printStackTrace();
            return null;
        }
    }

    public List<Customer> getAllCustomers() {
        try {
            return customer_repository.getAllCustomers();
        } catch (SQLException e) {
            e.printStackTrace();
            return null;
        }
    }

    public boolean addCustomer(Customer customer) {
        try {
            return customer_repository.addCustomer(customer); 
        } catch (SQLException e) {
        	System.err.println("Veritabanı kayıt hatası: " + e.getMessage());
            e.printStackTrace();
            return false;
        }
    }

    public void updateCustomer(Customer customer) {
        try {
            customer_repository.updateCustomer(customer);
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }

    public boolean deleteCustomer(int customerId) {
        try {
            return customer_repository.deleteCustomer(customerId); 
        } catch (SQLException e) {
            e.printStackTrace();
            return false;
        }
    }
    public boolean changePassword(int customerId, String oldPassword, String newPassword) {
        try {
            Customer customer = customer_repository.getCustomerById(customerId);
            if (customer != null && customer.getPassword().equals(oldPassword)) { // Güvenlik için hash karşılaştırması yapılmalı
                customer.setPassword(newPassword); // Yeni şifreyi hashleyerek kaydetmelisiniz
                customer_repository.updateCustomer(customer);
                return true;
            }
            return false;
        } catch (SQLException e) {
            e.printStackTrace();
            return false;
        }
    }

    public void closeConnection() {
        try {
            if (connection != null && !connection.isClosed()) {
                connection.close();
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}