package com.sellandrent.service_tier;

import com.sellandrent.model_tier.Car;
import com.sellandrent.model_tier.Motorcycle;
import com.sellandrent.model_tier.Vehicle;
import com.sellandrent.repository_tier.Vehicle_Repository;
import com.sellandrent.DatabaseConnectionTest;

import java.sql.Connection;
import java.sql.SQLException;
import java.util.List;
import java.util.Map;

public class VehicleService {
    private Vehicle_Repository vehicleRepository;
    private Connection connection;

    public VehicleService() {
        try {
            connection = DatabaseConnectionTest.createConnection();
            vehicleRepository = new Vehicle_Repository(connection);
        } catch (SQLException e) {
            
            e.printStackTrace();
        }
    }

    public Vehicle getVehicleById(int id) {
        try {
            return vehicleRepository.getVehicleById(id);
        } catch (SQLException e) {
            
            e.printStackTrace();
            return null;
        }
    }

    public List<Vehicle> getAllVehicles() {
        try {
            return vehicleRepository.getAllVehicles();
        } catch (SQLException e) {
            
            e.printStackTrace();
            return null;
        }
    }

    public void addVehicle(Vehicle vehicle) {
        try {
            vehicleRepository.addVehicle(vehicle);
        } catch (SQLException e) {
            
            e.printStackTrace();
        }
    }

    public void addVehicle(String brand, String model, int year, String type, Map<String, String> details) {
        Vehicle vehicle = null;
        if ("car".equalsIgnoreCase(type)) {
            int doors = Integer.parseInt(details.get("doors"));
            String fuel = details.get("fuel");
            vehicle = new Car(0, brand, model, year, doors, fuel); // ID veritabanı tarafından atanacağı için 0
        } else if ("motorcycle".equalsIgnoreCase(type)) {
            String engine = details.get("engine");
            boolean sidecar = Boolean.parseBoolean(details.get("sidecar"));
            vehicle = new Motorcycle(0, brand, model, year, engine, sidecar); // ID veritabanı tarafından atanacağı için 0
        }

        if (vehicle != null) {
            addVehicle(vehicle);
        }
    }

    public void updateVehicle(Vehicle vehicle) {
        try {
            vehicleRepository.updateVehicle(vehicle);
        } catch (SQLException e) {
            
            e.printStackTrace();
        }
    }

    public void updateVehicle(int id, String brand, String model, int year, String type, Map<String, String> details) {
        Vehicle vehicle = getVehicleById(id);
        if (vehicle != null) {
            vehicle.setBrand(brand);
            vehicle.setModel(model);
            vehicle.setYear(year);
            if (vehicle instanceof Car) {
                Car car = (Car) vehicle;
                if (details.containsKey("doors")) {
                    car.setNumberOfDoors(Integer.parseInt(details.get("doors")));
                }
                if (details.containsKey("fuel")) {
                    car.setFuelType(details.get("fuel"));
                }
            } else if (vehicle instanceof Motorcycle) {
                Motorcycle motorcycle = (Motorcycle) vehicle;
                if (details.containsKey("engine")) {
                    motorcycle.setEngineType(details.get("engine"));
                }
                if (details.containsKey("sidecar")) {
                    motorcycle.setHasSidecar(Boolean.parseBoolean(details.get("sidecar")));
                }
            }
            updateVehicle(vehicle);
        }
    }

    public void deleteVehicle(int id) {
        try {
            vehicleRepository.deleteVehicle(id);
        } catch (SQLException e) {
            
            e.printStackTrace();
        }
    }

    
    public void closeConnection() {
        try {
            if (connection != null && !connection.isClosed()) {
                connection.close();
            }
        } catch (SQLException e) {
            e.printStackTrace();
        }
    }
}